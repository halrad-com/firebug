<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- -windows, not plain net10.0: the subjects under test (FirebugManager,
         PortOwner, PortPicker) are [SupportedOSPlatform("windows")], so a
         cross-platform test assembly makes every call site a CA1416. The suite
         can only run on Windows anyway — netsh, http.sys, the firewall COM API. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Firebug.Tests</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.6">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Firebug\Firebug.csproj" />
    <ProjectReference Include="..\..\src\SsdpCore\SsdpCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The CLI is a net48 exe, so its pure line-editor logic is compiled in
         by link rather than referenced — both files are BCL-only. -->
    <Compile Include="..\..\src\Firebug.Cli\Completion.cs" Link="Cli\Completion.cs" />
    <Compile Include="..\..\src\Firebug.Cli\LineEditor.cs" Link="Cli\LineEditor.cs" />
    <Compile Include="..\..\src\Firebug.Cli\CliText.cs" Link="Cli\CliText.cs" />
    <Compile Include="..\..\src\Firebug.Cli\CommandCatalog.cs" Link="Cli\CommandCatalog.cs" />
    <Compile Include="..\..\src\Firebug.Cli\CompletionEmitter.cs" Link="Cli\CompletionEmitter.cs" />
  </ItemGroup>
</Project>
