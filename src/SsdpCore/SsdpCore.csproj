<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>SsdpCore</AssemblyName>
    <RootNamespace>SsdpCore</RootNamespace>
    <LangVersion>latest</LangVersion>

    <Version>0.5.0.2</Version>
    <FileVersion>0.5.0.2</FileVersion>
    <!-- Binding identity, pinned: on .NET Framework every AssemblyVersion bump
         breaks already-compiled consumers (FileLoadException without a binding
         redirect). Version/FileVersion carry the real number; this moves only
         on a breaking release. -->
    <AssemblyVersion>0.5.0.0</AssemblyVersion>
    <Copyright>Copyright (c) 2026 Halrad LLC</Copyright>
    <Company>Halrad LLC</Company>
    <Product>SsdpCore</Product>
    <Description>Local network discovery library — SSDP, WS-Discovery, and mDNS/DNS-SD</Description>

    <!-- NuGet package metadata -->
    <PackageId>Halrad.SsdpCore</PackageId>
    <Authors>Halrad LLC</Authors>
    <PackageDescription>Local network discovery library. SSDP (UPnP), WS-Discovery (Windows Network), and mDNS/DNS-SD — client and server roles.</PackageDescription>
    <PackageTags>ssdp;upnp;discovery;multicast;dlna;mdns;dns-sd</PackageTags>
    <!-- Matches the repo LICENSE (Apache-2.0) — was mistakenly MIT. -->
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/halrad-com/firebug</RepositoryUrl>
    <PackageProjectUrl>https://github.com/halrad-com/firebug</PackageProjectUrl>

    <!-- Ship the XML docs — the security reasoning lives in them.
         1591 (undocumented public member) stays a non-warning: docs are dense
         where they matter; the gaps are legacy members, not new surface. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>


</Project>
