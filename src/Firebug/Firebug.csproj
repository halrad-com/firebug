<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net48 stays: MBXHub.Core/.Plugin/.REST/.Tests are .NET Framework and in
         support. The modern target moved 8.0 -> 10.0 on 2026-09-29 because .NET 8
         is out of support; 10.0 is the minimum viable modern platform. The two
         modern consumers (MBXHub.Shell, mbxutil) are already net10.0-windows, so
         this turns a compatibility-resolved reference into an exact match. -->
    <TargetFrameworks>net48;net10.0</TargetFrameworks>
    <AssemblyName>Firebug</AssemblyName>
    <RootNamespace>Firebug</RootNamespace>
    <LangVersion>latest</LangVersion>

    <Version>0.5.0.1</Version>
    <FileVersion>0.5.0.1</FileVersion>
    <!-- Binding identity, pinned — same policy as SsdpCore: moves only on a
         breaking release so patch bumps don't break compiled consumers. -->
    <AssemblyVersion>0.5.0.0</AssemblyVersion>
    <Copyright>Copyright (c) 2026 Halrad LLC</Copyright>
    <Company>Halrad LLC</Company>
    <Product>Firebug</Product>
    <Description>Windows Firewall and URL ACL configuration library</Description>

    <!-- NuGet package metadata -->
    <PackageId>Halrad.Firebug</PackageId>
    <Authors>Halrad LLC</Authors>
    <PackageDescription>Windows Firewall and URL ACL configuration made simple. Add firewall rules and HTTP URL reservations with a clean API.</PackageDescription>
    <PackageTags>firewall;windows;netsh;urlacl;http</PackageTags>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/halrad-com/firebug</RepositoryUrl>
    <PackageProjectUrl>https://github.com/halrad-com/firebug</PackageProjectUrl>

    <!-- Ship the XML docs; 1591 (undocumented public member) stays a
         non-warning — same policy as SsdpCore. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- The rule projection seam (FirebugManager.Project) is pinned by tests. -->
    <InternalsVisibleTo Include="Firebug.Tests" />
  </ItemGroup>

</Project>
