<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>firebug</AssemblyName>
    <RootNamespace>Firebug.Cli</RootNamespace>
    <LangVersion>latest</LangVersion>

    <Version>0.4.10.0</Version>
    <FileVersion>0.4.10.0</FileVersion>
    <AssemblyVersion>0.4.10.0</AssemblyVersion>
    <Copyright>Copyright (c) 2026 Halrad LLC</Copyright>
    <Company>Halrad LLC</Company>
    <Product>Firewall Configuration Utility</Product>
    <AssemblyTitle>Firewall Configuration Utility</AssemblyTitle>
    <Description>Firewall Configuration Utility</Description>

    <!-- Embed the manifest for elevation -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <!-- PrivateAssets="all" ensures the libraries get merged, not copied -->
    <ProjectReference Include="..\Firebug\Firebug.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\SsdpCore\SsdpCore.csproj" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ILRepack.Lib.MSBuild.Task" Version="2.0.34.2">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- ILRepack: Merge Firebug.dll into firebug.exe -->
  <Target Name="ILRepack" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <ILRepackOutput>$(OutputPath)firebug.exe</ILRepackOutput>
    </PropertyGroup>
    <ItemGroup>
      <ILRepackAssemblies Include="$(OutputPath)Firebug.dll" />
      <ILRepackAssemblies Include="$(OutputPath)SsdpCore.dll" />
    </ItemGroup>
    <ILRepack
      InputAssemblies="@(ILRepackAssemblies)"
      MainAssembly="$(ILRepackOutput)"
      OutputFile="$(ILRepackOutput)"
      Internalize="true"
      Parallel="true" />
    <!-- Clean up merged DLLs -->
    <Delete Files="$(OutputPath)Firebug.dll;$(OutputPath)SsdpCore.dll" />
  </Target>

</Project>
